<Window x:Class="Pomodoro.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Pomodoro.App"
        Title="Ajustes de AutoPomodoro" Width="380" SizeToContent="Height" MaxHeight="760" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        Background="#174B80" Foreground="White" FontFamily="Segoe UI" UseLayoutRounding="True" SourceInitialized="Window_SourceInitialized" KeyDown="Window_KeyDown">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MouseLeftButtonDown="Surface_MouseLeftButtonDown">
            <TextBlock Text="AJUSTES" FontWeight="SemiBold" FontSize="26" Margin="0,0,0,24"/>
            <TextBlock Text="VOLUMEN" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" ToolTip="Probar volumen" Click="TestVolume_Click" AutomationProperties.Name="Probar volumen"><local:VolumeIcon Volume="{Binding Value, ElementName=VolumeSlider}" Foreground="White"/></Button>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource VolumeSlider}" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.AutomationId="SettingsVolume" AutomationProperties.Name="Volumen"/>
                <TextBlock x:Name="VolumePercentText" Grid.Column="2" Text="60%" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="MODO" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <RadioButton x:Name="StandardMode" Content="25 / 5" Background="#24985B" GroupName="Mode" Style="{StaticResource ModeButton}" AutomationProperties.AutomationId="Mode25"/>
                <RadioButton x:Name="ExtendedMode" Grid.Column="2" Content="50 / 10" Background="#C6384E" GroupName="Mode" Style="{StaticResource ModeButton}" AutomationProperties.AutomationId="Mode50"/>
            </Grid>
            <Button Content="RESTABLECER AJUSTES" Style="{StaticResource RoundedButton}" Click="Reset_Click" Margin="0,0,0,10"/>
            <Button Content="LISTO" Style="{StaticResource RoundedButton}" Foreground="#174B80" Background="White" Click="Done_Click" AutomationProperties.AutomationId="SettingsDone"/>
        </StackPanel>
    </ScrollViewer>
</Window>
