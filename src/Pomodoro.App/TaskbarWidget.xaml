<Window x:Class="Pomodoro.App.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pomodoro.App"
        Title="AutoPomodoro — barra de tareas" Width="114" Height="36" UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False">
    <Border Background="Black" CornerRadius="11" Padding="5,0">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="VolumeButton" Style="{StaticResource IconButton}" Width="28" Height="30" Padding="2"
                Foreground="{Binding Foreground, ElementName=Countdown}" Click="ToggleMute" MouseEnter="ShowVolume"
                AutomationProperties.AutomationId="WidgetVolumeButton" AutomationProperties.Name="Silenciar o activar sonido">
            <local:VolumeIcon x:Name="Speaker" Foreground="{Binding Foreground, ElementName=Countdown}"/>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="Auto" Height="34" Padding="0" Click="OpenWindow"
                AutomationProperties.AutomationId="WidgetCountdown" AutomationProperties.Name="Abrir AutoPomodoro como ventana">
            <TextBlock x:Name="Countdown" Text="25:00" FontFamily="Consolas" FontSize="23" FontWeight="Normal"
                       VerticalAlignment="Center" TextAlignment="Center" Typography.NumeralAlignment="Tabular"/>
        </Button>
        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top"
               AllowsTransparency="True" StaysOpen="True">
            <Border x:Name="VolumePanel" Background="#171717" CornerRadius="14" Padding="16"
                    MouseEnter="KeepVolumeOpen" MouseLeave="ScheduleVolumeClose">
                <StackPanel Width="180">
                    <TextBlock x:Name="VolumeLabel" Foreground="White" Text="60%" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Background="#505050"
                            AutomationProperties.AutomationId="WidgetVolume" AutomationProperties.Name="Volumen"
                            ValueChanged="VolumeChanged"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
    </Border>
</Window>
