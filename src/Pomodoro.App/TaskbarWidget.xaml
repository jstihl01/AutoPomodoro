<Window x:Class="Pomodoro.App.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoPomodoro — barra de tareas" Width="126" Height="36"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False">
    <Grid Background="#01000000" MouseRightButtonUp="OpenMenu">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Countdown" Text="25:00" FontFamily="Segoe UI" FontSize="23"
                   FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                   ToolTip="AutoPomodoro · Clic derecho para opciones"/>
        <Button x:Name="VolumeButton" Grid.Column="1" Content="&#xE767;" FontFamily="Segoe MDL2 Assets"
                Foreground="{Binding Foreground, ElementName=Countdown}" FontSize="17"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                Click="ToggleMute" MouseEnter="ShowVolume" ToolTip="Silenciar o activar sonido"/>
        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top"
               AllowsTransparency="True" StaysOpen="True">
            <Border x:Name="VolumePanel" Background="#F0252525" CornerRadius="8" Padding="14"
                    MouseEnter="KeepVolumeOpen" MouseLeave="ScheduleVolumeClose">
                <StackPanel Width="180">
                    <TextBlock x:Name="VolumeLabel" Foreground="White" Text="Volumen: 60%" Margin="0,0,0,8"/>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"
                            ValueChanged="VolumeChanged"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
