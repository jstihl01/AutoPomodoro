<Window x:Class="Pomodoro.App.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pomodoro.App"
        Title="AutoPomodoro — barra de tareas" Width="146" Height="38" UseLayoutRounding="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
    <Border Background="Black" CornerRadius="11" Padding="5,0">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="VolumeButton" Style="{StaticResource SpeakerToggle}" Width="28" Height="30" Padding="2"
                Foreground="{Binding Foreground, ElementName=Countdown}" Checked="MuteChanged" Unchecked="MuteChanged" MouseEnter="ShowVolume"
                ToolTip="Silenciar o activar sonido (F2 para ajustar el volumen)"
                AutomationProperties.AutomationId="WidgetVolumeButton" AutomationProperties.Name="Silenciar AutoPomodoro"
                AutomationProperties.HelpText="Pulsa F2 para enfocar el deslizador de volumen" AutomationProperties.AcceleratorKey="F2">
            <local:VolumeIcon x:Name="Speaker" Foreground="{Binding Foreground, ElementName=Countdown}"/>
        </ToggleButton>
        <Button x:Name="OpenWindowButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="Auto" Height="Auto" Padding="0" Click="OpenWindow"
                AutomationProperties.AutomationId="WidgetCountdown" AutomationProperties.Name="Abrir AutoPomodoro como ventana">
            <Viewbox StretchDirection="DownOnly">
                <StackPanel>
                    <TextBlock x:Name="Countdown" FontFamily="Consolas" FontSize="21" TextAlignment="Center"/>
                    <TextBlock x:Name="Phase" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                               TextAlignment="Center" LineHeight="12" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>
            </Viewbox>
        </Button>
        <TextBlock x:Name="StatusBadge" Grid.Column="2" Text="!" Foreground="#FFD464" FontWeight="Bold"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                   ToolTipService.ShowDuration="15000" AutomationProperties.LiveSetting="Polite"/>
        <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top"
               AllowsTransparency="True" StaysOpen="True">
            <Border x:Name="VolumePanel" Background="#171717" CornerRadius="14" Padding="16"
                    MouseEnter="KeepVolumeOpen" MouseLeave="ScheduleVolumeClose">
                <StackPanel Width="180">
                    <TextBlock x:Name="VolumeLabel" Foreground="White" Text="60%" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource VolumeSlider}" Background="#505050"
                            AutomationProperties.AutomationId="WidgetVolume" AutomationProperties.Name="Volumen"
                            ValueChanged="VolumeChanged"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
    </Border>
</Window>
